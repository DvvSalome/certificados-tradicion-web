# Variables que necesitan los scripts de recon/. Copiar a .env (que está en .gitignore)
# y rellenar. NINGÚN valor real va acá.
#
# Uso:  node --env-file=recon/.env recon/<script>.mjs
#
# Antes estas credenciales estaban escritas dentro de los scripts. Se sacaron el
# 2026-08-03. Ojo: las viejas siguen en el historial de git, así que hay que
# revocarlas, no solo cambiarlas de lugar.

# --- EasyPanel (panel del VPS viejo, por túnel SSH a localhost:3010) ---
EP_EMAIL=
EP_PASS=

# --- GitHub (deploy de repos privados desde EasyPanel) ---
# El token que estaba hardcodeado quedó comprometido. Revocarlo en GitHub.
GITHUB_TOKEN=

# --- SNR (cuenta que cobra por consulta, tratar con cuidado) ---
SNR_USER=
SNR_PASS=

# --- Postgres del proyecto ---
DATABASE_URL=

# --- Browserless ---
# BROWSERLESS_WS es la URL completa ws:// con el token incluido.
# BROWSERLESS_TOKEN es solo el token, para las URLs http://.../function
BROWSERLESS_WS=
BROWSERLESS_TOKEN=

# --- n8n ---
N8N_WEBHOOK_SECRET=

# --- Correo saliente ---
SMTP_USER=
SMTP_PASS=

# --- Wompi ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
